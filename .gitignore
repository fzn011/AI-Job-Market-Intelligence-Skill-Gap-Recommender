# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ─── Virtual environments ─────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ─── Environment / secrets ────────────────────────────────
.env
.env.local
.env.*.local
secrets.toml
.streamlit/secrets.toml

# ─── Jupyter Notebooks ────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Data files (keep sample, ignore large raw data) ──────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── Model files ──────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.bin
models/

# ─── Reports / outputs ────────────────────────────────────
reports/generated_reports/*
!reports/generated_reports/.gitkeep

# ─── OS files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs and editors ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Build / packaging ────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
